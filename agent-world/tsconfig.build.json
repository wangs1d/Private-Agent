  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "removeComments": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist", "standalone", "**/*.test.ts", "tests"]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sphere Overlay",
  "version": "0.1.0",
  "identifier": "com.private-agent.sphere-overlay",
  "build": {
    "frontendDist": "../../agent-sphere-avatar/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}

# ===== tool-router 独立部署（FastAPI 微服务）=====
# 两种集成方式：
# 1) HTTP REST（推荐）：TS 端配置 TOOL_ROUTER_HTTP_URL 指向本服务，搜索走 HTTP
# 2) stdio 子进程（兜底）：未配置 HTTP URL 时，TS 端 spawn scripts/bridge_worker.py

# 服务监听
TOOL_ROUTER_ENV=dev
TOOL_ROUTER_HOST=0.0.0.0
TOOL_ROUTER_PORT=8787
TOOL_ROUTER_DEFAULT_TENANT=default

# 可选外部后端（未配置时纯内存模式，接口照常可用）
# TOOL_ROUTER_REDIS_URL=redis://localhost:6379/0
# TOOL_ROUTER_QDRANT_URL=http://localhost:6333
# TOOL_ROUTER_POSTGRES_DSN=postgresql+psycopg://tool_router:tool_router@localhost:5432/tool_router
# TOOL_ROUTER_NEO4J_URI=bolt://localhost:7687
# TOOL_ROUTER_NEO4J_USERNAME=neo4j
# TOOL_ROUTER_NEO4J_PASSWORD=tool-router
# TOOL_ROUTER_RABBITMQ_URL=amqp://tool_router:tool_router@localhost:5672//

# 路由/检索调参
TOOL_ROUTER_ROUTE_CACHE_TTL_SECONDS=30
TOOL_ROUTER_SCHEMA_CACHE_SIZE=256
TOOL_ROUTER_RATE_LIMITED_FAILURE_THRESHOLD=3
TOOL_ROUTER_DEFAULT_BASE_SCORE=0.5
